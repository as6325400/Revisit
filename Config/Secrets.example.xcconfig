// Copy to Secrets.xcconfig (git-ignored) and fill in.

// Mapbox public token (pk....) from https://account.mapbox.com — used for the 3D replay
// and video export. Without it the replay falls back to Apple Maps and export is hidden.
MAPBOX_ACCESS_TOKEN = pk.your-token-here

// Only if you're not the project owner: your Apple Developer team ID (Xcode → Settings →
// Accounts, or developer.apple.com → Membership details) and a reverse-DNS prefix you own.
// REVISIT_DEVELOPMENT_TEAM = ABCDE12345
// REVISIT_BUNDLE_ID_PREFIX = com.yourname
